// Convenções (docs/database/modelo-dados.md, ADR-001):
// - id: UUID v7 gerado pela aplicação (Prisma), armazenado como uuid;
// - tabelas e colunas em snake_case no banco, camelCase no código;
// - created_at/updated_at em todas as tabelas, timestamptz;
// - dados de uma oficina sempre com tenant_id (a partir da Fase 1B).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Situação operacional da oficina na plataforma. A situação da assinatura
/// (TRIALING, ACTIVE, PAST_DUE…) pertence a Subscription (Fase 6).
enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED

  @@map("tenant_status")
}

/// Oficina — raiz do isolamento multi-tenant.
model Tenant {
  id        String       @id @default(uuid(7)) @db.Uuid
  legalName String       @map("legal_name") @db.VarChar(160)
  tradeName String?      @map("trade_name") @db.VarChar(160)
  /// CPF (11) ou CNPJ (14), somente dígitos. Formato garantido por CHECK na migration.
  document  String       @unique @db.VarChar(14)
  status    TenantStatus @default(TRIAL)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  users               User[]
  sessions            Session[]
  userRoles           UserRole[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  settings            TenantSettings?
  sequences           TenantSequence[]
  customers           Customer[]

  @@index([status])
  @@map("tenants")
}

// ---------------------------------------------------------------------------
// Configuração e numeração por oficina (docs/database/proposta-modelo-nucleo.md §3.1)
// ---------------------------------------------------------------------------

/// Configurações operacionais da oficina (1:1 com Tenant). Criada sob demanda com os padrões.
model TenantSettings {
  tenantId           String   @id @map("tenant_id") @db.Uuid
  /// Valor-hora padrão dos serviços HOURLY sem valor próprio. Nulo = não configurado
  /// (docs/modules/servicos.md §5).
  defaultHourlyRate  Decimal? @map("default_hourly_rate") @db.Decimal(12, 2)
  /// Validade padrão dos orçamentos em dias (docs/modules/orcamentos.md §4).
  quoteValidityDays  Int      @default(7) @map("quote_validity_days")
  /// Permite concluir OS com saldo insuficiente (docs/modules/ordens-servico.md §13.6).
  allowNegativeStock Boolean  @default(false) @map("allow_negative_stock")
  /// Fuso horário IANA da oficina.
  timezone           String   @default("America/Sao_Paulo") @db.VarChar(64)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("tenant_settings")
}

/// Numeração sequencial por oficina (ex.: OS-000123). `nextValue` é o próximo número a
/// emitir. Incremento atômico em src/modules/tenant-sequence/tenant-sequence.service.ts.
model TenantSequence {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String   @db.VarChar(40)
  nextValue Int      @default(1) @map("next_value")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, key])
  @@map("tenant_sequences")
}

// ---------------------------------------------------------------------------
// Identidade da oficina (tenant)
// ---------------------------------------------------------------------------

enum UserStatus {
  INVITED
  ACTIVE
  BLOCKED

  @@map("user_status")
}

/// Usuário de uma oficina. Pertence a exatamente um tenant (ADR-001).
model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  name         String     @db.VarChar(120)
  /// Sempre minúsculo (CHECK). Único em toda a plataforma: o login não pede a oficina.
  email        String     @unique @db.VarChar(254)
  /// Argon2id. Nulo enquanto o convite não for aceito. Nunca sai da API.
  passwordHash String?    @map("password_hash") @db.Text
  status       UserStatus @default(INVITED)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  roles               UserRole[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  /// Alvo das FKs compostas (tenant_id, user_id): impede vínculos entre oficinas.
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("users")
}

/// Sessão server-side de usuário de oficina. O cookie carrega um token aleatório;
/// aqui fica apenas o SHA-256 dele (ADR-001 decisões 6, 20 e 21).
model Session {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Expiração deslizante (12h de inatividade).
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Teto absoluto (7 dias), independente de atividade.
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason     String?   @map("revoked_reason") @db.VarChar(40)
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.VarChar(512)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Token de redefinição de senha. Guarda somente o SHA-256 do token enviado por e-mail.
/// Uso único (usedAt), expira em 30 min e é revogado quando um novo é solicitado.
model PasswordResetToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  requestedIp String?   @map("requested_ip") @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// RBAC — catálogo global (sincronizado de @ztech/validation) + atribuição por oficina
// ---------------------------------------------------------------------------

/// Papel do sistema (OWNER, ADMIN…). Global: o mesmo catálogo vale para todas as oficinas.
model Role {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique @db.VarChar(40)
  name      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

/// Permissão atômica no formato recurso.ação (ex.: customers.read).
model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique @db.VarChar(80)
  description String   @db.VarChar(160)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Papel atribuído a um usuário dentro da oficina. Um usuário pode ter vários papéis.
model UserRole {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, roleId])
  @@index([tenantId])
  @@index([roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Plataforma (equipe ZTech) — separada dos usuários das oficinas
// ---------------------------------------------------------------------------

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT

  @@map("platform_role")
}

enum PlatformUserStatus {
  ACTIVE
  BLOCKED

  @@map("platform_user_status")
}

/// Usuário da equipe ZTech. NÃO pertence a nenhum tenant e nunca é tratado como
/// usuário de oficina. Sessões e login da plataforma chegam com o painel da plataforma.
model PlatformUser {
  id           String             @id @default(uuid(7)) @db.Uuid
  name         String             @db.VarChar(120)
  email        String             @unique @db.VarChar(254)
  passwordHash String             @map("password_hash") @db.Text
  role         PlatformRole       @default(SUPPORT)
  status       PlatformUserStatus @default(ACTIVE)
  lastLoginAt  DateTime?          @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_users")
}

// ---------------------------------------------------------------------------
// Auditoria — somente inserção (trigger no banco bloqueia UPDATE/DELETE)
// ---------------------------------------------------------------------------

enum AuditActorType {
  USER
  PLATFORM_USER
  SYSTEM

  @@map("audit_actor_type")
}

/// Registro de ações críticas. userId/platformUserId sem FK de propósito: o histórico
/// sobrevive à exclusão do usuário. metadata é sanitizada antes de gravar (sem segredos).
model AuditLog {
  id             String         @id @default(uuid(7)) @db.Uuid
  tenantId       String?        @map("tenant_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  userId         String?        @map("user_id") @db.Uuid
  platformUserId String?        @map("platform_user_id") @db.Uuid
  action         String         @db.VarChar(80)
  entity         String?        @db.VarChar(80)
  entityId       String?        @map("entity_id") @db.VarChar(80)
  metadata       Json?
  requestId      String?        @map("request_id") @db.VarChar(64)
  ipAddress      String?        @map("ip_address") @db.VarChar(45)
  userAgent      String?        @map("user_agent") @db.VarChar(512)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Clientes (docs/modules/clientes.md)
// ---------------------------------------------------------------------------

enum PersonType {
  INDIVIDUAL
  BUSINESS

  @@map("person_type")
}

/// INACTIVE é a exclusão lógica; BLOCKED impede novos atendimentos (clientes.md §8).
enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED

  @@map("customer_status")
}

enum ContactPreference {
  WHATSAPP
  EMAIL
  PHONE
  NONE

  @@map("contact_preference")
}

/// Cliente da oficina (pessoa física ou jurídica). Telefones, documento e CEP somente dígitos.
model Customer {
  id                String            @id @default(uuid(7)) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  /// Número sequencial por oficina (TenantSequence "CUSTOMER"), exibido como CLI-000001. Imutável.
  number            Int
  personType        PersonType        @map("person_type")
  /// Nome completo (INDIVIDUAL) ou razão social (BUSINESS).
  name              String            @db.VarChar(160)
  /// Somente BUSINESS (CHECK).
  tradeName         String?           @map("trade_name") @db.VarChar(160)
  /// CPF (11) para INDIVIDUAL ou CNPJ (14) para BUSINESS (CHECK). Único por oficina.
  document          String            @db.VarChar(14)
  status            CustomerStatus    @default(ACTIVE)
  phone             String            @db.VarChar(11)
  whatsapp          String?           @db.VarChar(11)
  /// Sempre minúsculo (CHECK).
  email             String?           @db.VarChar(254)
  secondaryPhone    String?           @map("secondary_phone") @db.VarChar(11)
  secondaryEmail    String?           @map("secondary_email") @db.VarChar(254)
  zipCode           String?           @map("zip_code") @db.Char(8)
  street            String?           @db.VarChar(160)
  addressNumber     String?           @map("address_number") @db.VarChar(20)
  complement        String?           @db.VarChar(80)
  neighborhood      String?           @db.VarChar(80)
  city              String?           @db.VarChar(80)
  state             String?           @db.Char(2)
  contactPreference ContactPreference @map("contact_preference")
  /// Observações internas.
  notes             String?           @db.VarChar(2000)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Alvo das FKs compostas (tenant_id, customer_id) de veículos, orçamentos e OS.
  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, document])
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@map("customers")
}

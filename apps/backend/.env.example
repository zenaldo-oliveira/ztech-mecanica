# Copie para .env e ajuste. Nunca coloque segredos reais neste arquivo.
# Variáveis validadas na inicialização (src/config/env.ts) — ausência = falha rápida.

NODE_ENV=development
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info

# PostgreSQL local do docker-compose.yml da raiz (porta 5433). Somente desenvolvimento.
DATABASE_URL=postgresql://ztech:ztech_dev_password@127.0.0.1:5433/ztech?schema=public
# Banco dos testes de integração. Precisa ser diferente de DATABASE_URL e terminar em "_test".
TEST_DATABASE_URL=postgresql://ztech:ztech_dev_password@127.0.0.1:5433/ztech_test?schema=public

# Senha dos usuários de demonstração criados pelo seed (somente desenvolvimento).
SEED_DEMO_PASSWORD=demo-ztech-2026

# Variáveis do Docker Compose de DESENVOLVIMENTO (docker-compose.yml).
# Copie para .env se quiser alterar os padrões. Nunca use estes valores em produção.
# Porta 5433 por padrão para não conflitar com outro PostgreSQL local na 5432.
POSTGRES_USER=ztech
POSTGRES_PASSWORD=ztech_dev_password
POSTGRES_DB=ztech
POSTGRES_PORT=5433
